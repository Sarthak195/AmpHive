# Flash size - 4MB
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# Partition table - dual-OTA slots + rollback (2026-07-07). NVS keeps the
# pre-OTA offset so provisioning survives the migration flash.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_ota.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# OTA hardening (2026-07-10): direct-MQTT devices fetch images across the
# public internet, so plain http:// is no longer accepted (ALLOW_HTTP removed;
# esp_https_ota rejects non-https URLs) and every update must be SIGNED.
#
# Signed-app verification WITHOUT hardware secure boot (ECDSA scheme v1):
# the build appends an ECDSA NIST256p signature made with
# firmware/secure_boot_signing_key.pem (gitignored - generate once with
# `espsecure.py generate_signing_key --version 1`, back it up; losing it means
# devices only accept a physical reflash). The public half is embedded in the
# app; esp_ota_set_boot_partition verifies the downloaded image on update.
# No eFuses are burned and boot-time verification stays off - fully reversible.
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=y
CONFIG_SECURE_SIGNED_APPS_ECDSA_SCHEME=y
CONFIG_SECURE_SIGNED_ON_UPDATE_NO_SECURE_BOOT=y
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=y
CONFIG_SECURE_BOOT_SIGNING_KEY="secure_boot_signing_key.pem"

# TLS/HTTPS
CONFIG_ESP_TLS_USING_MBEDTLS=y
CONFIG_MBEDTLS_SSL_PROTO_TLS1_2=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_SSL_VARIABLE_BUFFER_LENGTH=y


# Networking
CONFIG_LWIP_IPV4=y
CONFIG_LWIP_IP4_FRAG=y
CONFIG_LWIP_IP4_REASSEMBLY=y

# Captive-portal HTTP server: a phone browser's request headers (User-Agent,
# Accept-*, plus Origin/Referer added on the POST) overflow the 512-byte
# default, so httpd rejects POST /save with "header fields are too long" (hit
# provisioning gateway 1cc3abb4fb54 on 2026-07-15; had to fall back to a curl
# POST). Double the cap so phone-browser provisioning works out of the box.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# Stack size - increased significantly
CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768
