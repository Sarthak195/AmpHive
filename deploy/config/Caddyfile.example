# AmpHive TLS reverse proxy (Caddy) — REFERENCE ONLY.
#
# You normally never copy this file anywhere: deploy/scripts/deploy.ps1
# generates the real Caddyfile on the VM from CADDY_DOMAIN / ACME_EMAIL in
# .env on every (default, TLS) deploy. This example mirrors what it produces.
#
# Caddy automatically obtains and renews a Let's Encrypt certificate for the
# domain (HTTP-01 challenge on :80), persisted in the caddy_data volume.
#
# Requirements:
#   - CADDY_DOMAIN resolves to the VM's public IP (the DuckDNS updater cron on
#     the VM keeps amphive.duckdns.org pointed there).
#   - GCP firewall allows inbound tcp:80 AND tcp:443 to the VM.

amphive.duckdns.org {
	encode gzip

	# WebSocket + API + SPA all live behind the frontend nginx container, which
	# already proxies /api and /socket.io to the backend. Caddy just terminates
	# TLS and forwards everything to it.
	reverse_proxy frontend:80
}

# Requests arriving by bare IP / unknown Host go to the canonical origin.
http:// {
	redir https://amphive.duckdns.org{uri}
}
