# Copy to the repo root as .env and fill in real values. NEVER commit .env.
# deploy.ps1 refuses to deploy if JWT_SECRET_KEY is missing/weak/a known default.

# Postgres runs as a Docker container on the VM ('db' resolves in the Compose network).
# POSTGRES_PASSWORD is interpolated into docker-compose.prod.yml AND into
# DATABASE_URL by deploy.ps1 — set one strong value here.
POSTGRES_PASSWORD=set-a-strong-db-password
# DATABASE_URL is the OWNER connection (superuser in prod): used ONLY for
# migrations + one-time runtime-role provisioning, never to serve requests.
DATABASE_URL=postgresql+asyncpg://postgres:set-a-strong-db-password@db:5432/amphive

# ── DB privilege separation (SECURITY.md) ────────────────────────────────────
# Set APP_DB_PASSWORD to a strong value to serve every request through a
# NON-superuser role (default name amphive_app) that holds only
# SELECT/INSERT/UPDATE/DELETE — it CANNOT DROP/ALTER tables, so a future SQLi
# can't escalate to schema loss. On the next backend boot the app idempotently
# creates/updates that role (using the owner connection above) and connects the
# request engine as it; migrations keep running as the owner. Leave APP_DB_PASSWORD
# UNSET to keep the old behavior (requests serve as the DATABASE_URL role).
# Activate: set APP_DB_PASSWORD, restart the backend, and confirm the startup log
# says "DB privilege separation ACTIVE". APP_DB_USER overrides the role name.
APP_DB_PASSWORD=
# APP_DB_USER=amphive_app

# ── Firmware OTA image publishing (admin upload) ─────────────────────────────
# The admin "Upload image" endpoint now PUBLISHES the uploaded .bin to the
# public bucket gs://amphive-fw (keyless — the VM's compute service account,
# same identity backup_db.sh uses) and registers the bucket URL. FIRMWARE_GCS_BUCKET
# overrides the bucket name; empty = the default below. INFRA PREREQUISITE: the
# compute SA needs roles/storage.objectCreator on the bucket — see
# deploy/docs/ota_image_publishing.md. No key file / no volume needed.
FIRMWARE_GCS_BUCKET=amphive-fw
#
# LEGACY (self-hosting) — only the retained GET /api/firmware/images/{file}
# back-compat endpoint still reads these; new uploads no longer use them:
#   PUBLIC_API_ORIGIN  — was stamped into self-hosted image URLs (fell back to
#                        FRONTEND_ORIGIN when empty).
#   FIRMWARE_IMAGE_DIR — was where uploaded .bin files were stored.
# CAVEAT: real-device OTA was UNRELIABLE from that self-hosted path (the ESP32
# TLS download breaks mid-stream) AND non-persistent (deploy.ps1 doesn't ship
# the firmware_images volume), which is exactly why uploads now go to
# gs://amphive-fw. See docs/TODO.md "2026-08-04 reliability & integration backlog".
# PUBLIC_API_ORIGIN=
# FIRMWARE_IMAGE_DIR=data/firmware-images

MQTT_BROKER_HOST=mqtt
MQTT_BROKER_PORT=1883
# Host IP the broker's PLAINTEXT port binds to. Plaintext 1883 is NOT
# host-published in the live relay deploy, so this only matters if you re-enable
# that listener (the retired docker-compose.prod.yml rollback path does publish
# it). Default 127.0.0.1: 0.0.0.0 would put unencrypted MQTT - including the
# gateway credentials presented on it - on the public internet. Gateways use
# the TLS listener on 8883 (MQTT_TLS_BIND_IP below).
MQTT_BIND_IP=127.0.0.1
# Host IP the broker's public TLS port (8883) binds to. This is the live
# knob: direct-MQTT gateways dial mqtts://mqtt.amphive.app:8883 from anywhere,
# so this is 0.0.0.0 by default.
MQTT_TLS_BIND_IP=0.0.0.0

# MQTT broker credentials. deploy.ps1 hashes these into the mosquitto passwd
# file on the VM (backend client only). Gateways each get their own
# username/password + topic ACL (amphive/gateways/%u/#), provisioned via
# deploy/scripts/add_gateway_user.ps1 — there is no shared gateway account.
# ALPHANUMERIC/-/_ ONLY — the values pass through shell + compose interpolation.
# Anonymous access is NOT allowed (mosquitto.conf: allow_anonymous false).
MQTT_USERNAME=amphive-backend
MQTT_PASSWORD=set-a-strong-mqtt-password

# Web TLS (Caddy front door — the default deploy). deploy.ps1 generates the
# VM's Caddyfile from these: the public hostname Caddy obtains a Let's Encrypt
# cert for (must resolve to the VM's public IP), and an optional ACME account
# email for expiry notices. Deploy with -NoTls to ship the plain-HTTP stack.
CADDY_DOMAIN=amphive.app
# Optional second hostname for the CPO operator portal (same stack/bundle —
# the SPA partitions the experience by hostname). Empty = single-hostname
# deploy.
CADDY_CPO_DOMAIN=cpo.amphive.app
ACME_EMAIL=

# CORS allowlist EXTRA origins (comma-separated). The real .app domains are
# always allowed; this adds MORE — leave EMPTY in production. Because CORS runs
# with allow_credentials=true, trusting a localhost origin in prod would let a
# page served from localhost ride a logged-in user's credentials against prod.
# For LOCAL DEV against a Vite/CRA frontend, set:
#   CORS_EXTRA_ORIGINS=http://localhost:5173,http://localhost:3000
# Shared by the FastAPI CORS middleware and the Socket.io server.
CORS_EXTRA_ORIGINS=

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-in-production

# Auth rate limits, "<attempts>/<window seconds>" per client IP (in-process
# sliding window; SECURITY.md 8.6). Defaults shown.
LOGIN_RATE_LIMIT=10/60
REGISTER_RATE_LIMIT=10/3600
FORGOT_PASSWORD_RATE_LIMIT=5/3600
RESET_PASSWORD_RATE_LIMIT=10/3600
# Email-verification limits (per client IP). verify-email bounds online token
# guessing (the 256-bit token makes it academic, matches reset-password);
# resend-verification is tighter since each allowed call can trigger an email.
VERIFY_EMAIL_RATE_LIMIT=10/3600
RESEND_VERIFICATION_RATE_LIMIT=5/3600
# Per-SUBMITTED-EMAIL cap on forgot-password, layered on top of the per-IP
# limit above so an attacker with an IP pool can't mailbomb one victim's inbox
# (or trip our SMTP reputation) by rotating source addresses. Keyed on the
# email, enumeration-safe (fires identically for existing/non-existing). Default 3/3600.
FORGOT_PASSWORD_EMAIL_RATE_LIMIT=3/3600
# Same per-SUBMITTED-EMAIL mailbomb cap for resend-verification, enumeration-safe
# (checked before the account lookup, keyed on the normalized email). Default 3/3600.
RESEND_VERIFICATION_EMAIL_RATE_LIMIT=3/3600

# Per-IP cap on the Socket.io HANDSHAKE. The blanket API limit below only
# covers /api/ paths, so the /socket.io/ namespace previously had none -- and
# every connect attempt costs a JWT decode plus a users SELECT before an
# invalid token is refused. Default 60/60.
SOCKETIO_CONNECT_RATE_LIMIT=60/60

# Blanket per-IP limit over EVERY /api route — the middleware floor under the
# dedicated per-route rules above/below (/api/health exempt). "off" disables.
API_RATE_LIMIT=300/60

# Per-account rate limits, "<attempts>/<window seconds>" keyed by user id (or,
# for login, the normalized email) instead of client IP — layered on top of
# the per-IP limits above so one account rotating source IPs can't bypass
# them. Defaults shown.
SESSION_START_ACCOUNT_RATE_LIMIT=20/60
SESSION_STOP_ACCOUNT_RATE_LIMIT=20/60
PAYMENTS_CREATE_ORDER_ACCOUNT_RATE_LIMIT=10/60
CPO_TOPUP_ACCOUNT_RATE_LIMIT=20/60
LOGIN_ACCOUNT_RATE_LIMIT=10/60
# Brute-force limiters on the two "guess a shared secret" surfaces.
GROUP_JOIN_ACCOUNT_RATE_LIMIT=10/60
CPO_SETUP_ACCOUNT_RATE_LIMIT=5/300

# Max request body size (bytes) — 413 above this; nginx also caps at 1m. 1 MiB.
MAX_REQUEST_BODY_BYTES=1048576
# Carve-out for the ONE >1 MiB body: POST /api/admin/firmware-releases/upload
# (raw signed OTA image, ~1-2 MB; nginx allows 8m on that location). 4 MiB.
FIRMWARE_UPLOAD_MAX_BYTES=4194304

# Interactive API docs (/docs, /redoc, /openapi.json). OFF unless set: they
# publish a complete map of every route with its schemas and sit outside the
# blanket /api/ rate limiter's path prefix. Leave unset in production; set to 1
# for local development.
# ENABLE_API_DOCS=1

# Mask email addresses in log output (default on). Every auth event and CPO
# mutation logs the actor's address; user_id is the real correlator, so the raw
# address is data-minimised out of logs, log shippers and log backups. Set to 0
# only as a temporary incident-response escape hatch.
# LOG_REDACT_PII=0

# When SMTP_HOST is UNSET the mail body is redacted from the console-fallback
# log line, because the reset/verification bodies carry a live single-use token
# that takes over the account. Set to `full` to print the body (i.e. the link)
# when developing without a mail provider.
# EMAIL_CONSOLE_FALLBACK=full

# Password reset ("forgot password") email delivery. If SMTP_HOST is unset a
# WARNING records that mail was NOT delivered (see EMAIL_CONSOLE_FALLBACK
# above for how to print the link during local development). STARTTLS; login
# skipped when SMTP_USER is empty. Links point at
# FRONTEND_ORIGIN/reset-password?token=... and expire after
# RESET_TOKEN_TTL_MIN minutes (single use).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
FRONTEND_ORIGIN=https://amphive.app
RESET_TOKEN_TTL_MIN=30
# [Email verification] How long an emailed "verify your email" link stays valid
# (minutes, single use). Links point at FRONTEND_ORIGIN/verify-email?token=...
# and are delivered via the same SMTP_* settings (console-log fallback when
# SMTP_HOST is unset). 24 h default — a new user may not click immediately.
EMAIL_VERIFICATION_TTL_MIN=1440

# Transactional billing email (services/billing_emails.py): the driver's bill
# after a charging session finalizes, and a receipt when a CPO credits an
# offline (cash) top-up. Delivered via the same SMTP_* settings above (and
# subject to the same console-log fallback when SMTP_HOST is unset). Default
# on; set to off/0/false/disabled to silence both sends without touching
# password-reset delivery.
BILLING_EMAILS=on

# "Sign in with Google" (backend-driven authorization-code flow — see
# routers/auth.py google_login/google_callback). All three must be set or the
# feature is hidden everywhere: GET /api/config's google_login_enabled is
# false and /api/auth/google/login 503s. Create the OAuth client at
# https://console.cloud.google.com/apis/credentials ("Web application" type).
# GOOGLE_OAUTH_REDIRECT_URI must be added to that client's "Authorized
# redirect URIs" verbatim, e.g. https://amphive.app/api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://amphive.app/api/auth/google/callback

# Web Push (driver notifications). Generate the keypair with:
#   python -c "from py_vapid import Vapid, b64urlencode; from cryptography.hazmat.primitives import serialization; v=Vapid(); v.generate_keys(); print(b64urlencode(v.private_key.private_numbers().private_value.to_bytes(32,'big')))"
# The public applicationServerKey is derived from the private key at runtime.
# Empty = push disabled (in-app + Socket.io notifications still work).
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com

RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

COINS_PER_RUPEE=1.0
COINS_PER_KWH=5.0

# Minimum AVAILABLE balance (coins) required to start a session (402 below
# it; also shown by GET /api/config so the UI quotes the enforced number).
# Empty = code default (50).
MIN_START_BALANCE_COINS=50

# CPO payout ledger: the platform's cut, as a percent of a tenant's gross
# settled earnings (services/payouts.py). Record-keeping only — no
# bank/UPI/payment-gateway integration; the admin marks payouts paid manually.
PLATFORM_FEE_PCT=10.0

# GST tax invoices (services/invoices.py): the single intra-state GST rate,
# as a percent, charged INCLUSIVE in coins_spent (1 coin = ₹1). CGST/SGST vs.
# IGST is not split out — see the Invoice model docstring.
GST_RATE_PCT=18.0

# Telemetry time-series retention in days (0 = keep forever). The prune runs
# ~hourly inside the flush loop; telemetry_readings grows ~1 row/s while a
# session is being watched live, so keep this set in production.
TELEMETRY_RETENTION_DAYS=90

# Forwarded firmware log-line (gateway_logs, TD#28 diagnostics feed)
# retention in days — much shorter than TELEMETRY_RETENTION_DAYS since these
# are high-volume, low-value-per-row WARN/ERROR lines. Pruned by the session
# reaper every GATEWAY_LOGS_PRUNE_EVERY_N_TICKS ticks.
GATEWAY_LOGS_RETENTION_DAYS=14

# Circuit admission control and plug caps configuration. Empty = code defaults.
# DEFAULT_PLUG_CAP_A: a plug's default current capacity in amps when unset
# on the plug record; P110 hardware cutoff is 16A (default: 16)
DEFAULT_PLUG_CAP_A=16
# ENFORCE_CIRCUIT_ADMISSION: master switch for circuit admission gate
# (default: true; set to false for pre-caps behavior)
ENFORCE_CIRCUIT_ADMISSION=true

# Reservation policy configuration. Empty = code defaults.
# RESERVATION_MAX_HOURS: longest bookable window in hours (default: 4)
RESERVATION_MAX_HOURS=4
# RESERVATION_MAX_ADVANCE_DAYS: how far ahead a window may start in days
# (default: 7)
RESERVATION_MAX_ADVANCE_DAYS=7
# MAX_UPCOMING_RESERVATIONS_PER_USER: max BOOKED-with-future-end per user
# (default: 2)
MAX_UPCOMING_RESERVATIONS_PER_USER=2
# RESERVATION_NO_SHOW_GRACE_MIN: lazy no-show expiry grace in minutes
# (default: 15)
RESERVATION_NO_SHOW_GRACE_MIN=15
# RESERVATION_WALKUP_WARN_LOOKAHEAD_MIN: walk-up advance warning horizon
# in minutes (default: 180)
RESERVATION_WALKUP_WARN_LOOKAHEAD_MIN=180
