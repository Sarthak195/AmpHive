# Copy to the repo root as .env and fill in real values. NEVER commit .env.
# deploy.ps1 refuses to deploy if JWT_SECRET_KEY is missing/weak/a known default.

# Postgres runs as a Docker container on the VM ('db' resolves in the Compose network).
# POSTGRES_PASSWORD is interpolated into docker-compose.prod.yml AND into
# DATABASE_URL by deploy.ps1 — set one strong value here.
POSTGRES_PASSWORD=set-a-strong-db-password
DATABASE_URL=postgresql+asyncpg://postgres:set-a-strong-db-password@db:5432/amphive

MQTT_BROKER_HOST=mqtt
MQTT_BROKER_PORT=1883
# Host IP the broker's public port binds to. 0.0.0.0 = exposed to the internet
# (legacy). Set to the VM's overlay/Tailscale IP (e.g. 100.87.241.70) so only
# overlay peers — i.e. the ESP32 gateways — can reach MQTT.
MQTT_BIND_IP=0.0.0.0

# MQTT broker credentials. deploy.ps1 hashes these into the mosquitto passwd
# file on the VM (backend client + one shared gateway account); the gateway
# pair is also provisioned into each ESP32's NVS (mqtt_user/mqtt_pwd).
# ALPHANUMERIC/-/_ ONLY — the values pass through shell + compose interpolation.
# Anonymous access stays allowed until the stage-2 flip in mosquitto.conf.
MQTT_USERNAME=amphive-backend
MQTT_PASSWORD=set-a-strong-mqtt-password
MQTT_GW_USERNAME=amphive-gateway
MQTT_GW_PASSWORD=set-a-strong-gateway-mqtt-password

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-in-production

RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

COINS_PER_RUPEE=1.0
COINS_PER_KWH=5.0

# [Direct Mode] optional — ESP32 bypass for dev/test
DIRECT_MODE=false
TAPO_USERNAME=
TAPO_PASSWORD=
TAPO_PLUG_IP=
TAPO_RELAY_URL=
