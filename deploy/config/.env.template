# Copy to the repo root as .env and fill in real values. NEVER commit .env.
# deploy.ps1 refuses to deploy if JWT_SECRET_KEY is missing/weak/a known default.

# Postgres runs as a Docker container on the VM ('db' resolves in the Compose network).
# POSTGRES_PASSWORD is interpolated into docker-compose.prod.yml AND into
# DATABASE_URL by deploy.ps1 — set one strong value here.
POSTGRES_PASSWORD=set-a-strong-db-password
DATABASE_URL=postgresql+asyncpg://postgres:set-a-strong-db-password@db:5432/amphive

MQTT_BROKER_HOST=mqtt
MQTT_BROKER_PORT=1883
# Host IP the broker's plaintext port binds to. 0.0.0.0 = exposed to the
# internet (legacy). Plaintext 1883 is NOT host-published in the current
# deploy; this only matters if you re-enable that listener.
MQTT_BIND_IP=0.0.0.0
# Host IP the broker's public TLS port (8883) binds to. This is the live
# knob: direct-MQTT gateways dial mqtts://mqtt.amphive.app:8883 from anywhere,
# so this is 0.0.0.0 by default.
MQTT_TLS_BIND_IP=0.0.0.0

# MQTT broker credentials. deploy.ps1 hashes these into the mosquitto passwd
# file on the VM (backend client only). Gateways each get their own
# username/password + topic ACL (amphive/gateways/%u/#), provisioned via
# deploy/scripts/add_gateway_user.ps1 — there is no shared gateway account.
# ALPHANUMERIC/-/_ ONLY — the values pass through shell + compose interpolation.
# Anonymous access is NOT allowed (mosquitto.conf: allow_anonymous false).
MQTT_USERNAME=amphive-backend
MQTT_PASSWORD=set-a-strong-mqtt-password

# Web TLS (Caddy front door — the default deploy). deploy.ps1 generates the
# VM's Caddyfile from these: the public hostname Caddy obtains a Let's Encrypt
# cert for (must resolve to the VM's public IP), and an optional ACME account
# email for expiry notices. Deploy with -NoTls to ship the plain-HTTP stack.
CADDY_DOMAIN=amphive.app
# Optional second hostname for the CPO operator portal (same stack/bundle —
# the SPA partitions the experience by hostname). Empty = single-hostname
# deploy.
CADDY_CPO_DOMAIN=cpo.amphive.app
ACME_EMAIL=

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-in-production

# Auth rate limits, "<attempts>/<window seconds>" per client IP (in-process
# sliding window; SECURITY.md 8.6). Defaults shown.
LOGIN_RATE_LIMIT=10/60
REGISTER_RATE_LIMIT=10/3600
FORGOT_PASSWORD_RATE_LIMIT=5/3600
RESET_PASSWORD_RATE_LIMIT=10/3600

# Password reset ("forgot password") email delivery. If SMTP_HOST is unset the
# reset link is logged at WARNING instead of emailed (console fallback — copy
# it out of `docker logs amphive-backend`). STARTTLS; login skipped when
# SMTP_USER is empty. Links point at FRONTEND_ORIGIN/reset-password?token=...
# and expire after RESET_TOKEN_TTL_MIN minutes (single use).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
FRONTEND_ORIGIN=https://amphive.app
RESET_TOKEN_TTL_MIN=30

# Web Push (driver notifications). Generate the keypair with:
#   python -c "from py_vapid import Vapid, b64urlencode; from cryptography.hazmat.primitives import serialization; v=Vapid(); v.generate_keys(); print(b64urlencode(v.private_key.private_numbers().private_value.to_bytes(32,'big')))"
# The public applicationServerKey is derived from the private key at runtime.
# Empty = push disabled (in-app + Socket.io notifications still work).
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com

RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

COINS_PER_RUPEE=1.0
COINS_PER_KWH=5.0

# Minimum AVAILABLE balance (coins) required to start a session (402 below
# it; also shown by GET /api/config so the UI quotes the enforced number).
# Empty = code default (50).
MIN_START_BALANCE_COINS=50

# CPO payout ledger: the platform's cut, as a percent of a tenant's gross
# settled earnings (services/payouts.py). Record-keeping only — no
# bank/UPI/payment-gateway integration; the admin marks payouts paid manually.
PLATFORM_FEE_PCT=10.0

# GST tax invoices (services/invoices.py): the single intra-state GST rate,
# as a percent, charged INCLUSIVE in coins_spent (1 coin = ₹1). CGST/SGST vs.
# IGST is not split out — see the Invoice model docstring.
GST_RATE_PCT=18.0

# Telemetry time-series retention in days (0 = keep forever). The prune runs
# ~hourly inside the flush loop; telemetry_readings grows ~1 row/s while a
# session is being watched live, so keep this set in production.
TELEMETRY_RETENTION_DAYS=90

# Forwarded firmware log-line (gateway_logs, TD#28 diagnostics feed)
# retention in days — much shorter than TELEMETRY_RETENTION_DAYS since these
# are high-volume, low-value-per-row WARN/ERROR lines. Pruned by the session
# reaper every GATEWAY_LOGS_PRUNE_EVERY_N_TICKS ticks.
GATEWAY_LOGS_RETENTION_DAYS=14

# [Direct Mode] optional — ESP32 bypass for dev/test
DIRECT_MODE=false
TAPO_USERNAME=
TAPO_PASSWORD=
TAPO_PLUG_IP=
TAPO_RELAY_URL=

# Circuit admission control and plug caps configuration. Empty = code defaults.
# DEFAULT_PLUG_CAP_A: a plug's default current capacity in amps when unset
# on the plug record; P110 hardware cutoff is 16A (default: 16)
DEFAULT_PLUG_CAP_A=16
# ENFORCE_CIRCUIT_ADMISSION: master switch for circuit admission gate
# (default: true; set to false for pre-caps behavior)
ENFORCE_CIRCUIT_ADMISSION=true

# Reservation policy configuration. Empty = code defaults.
# RESERVATION_MAX_HOURS: longest bookable window in hours (default: 4)
RESERVATION_MAX_HOURS=4
# RESERVATION_MAX_ADVANCE_DAYS: how far ahead a window may start in days
# (default: 7)
RESERVATION_MAX_ADVANCE_DAYS=7
# MAX_UPCOMING_RESERVATIONS_PER_USER: max BOOKED-with-future-end per user
# (default: 2)
MAX_UPCOMING_RESERVATIONS_PER_USER=2
# RESERVATION_NO_SHOW_GRACE_MIN: lazy no-show expiry grace in minutes
# (default: 15)
RESERVATION_NO_SHOW_GRACE_MIN=15
# RESERVATION_WALKUP_WARN_LOOKAHEAD_MIN: walk-up advance warning horizon
# in minutes (default: 180)
RESERVATION_WALKUP_WARN_LOOKAHEAD_MIN=180
