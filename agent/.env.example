# AmpHive Agent configuration (export these, or use a dotenv loader).

# --- required: identity + broker ---
AMPHIVE_GATEWAY_ID=agent-lab-01        # this agent registers as this gateway_id
AMPHIVE_BROKER=8.231.81.12              # AmpHive broker (public, TLS)
AMPHIVE_USE_TLS=true                    # true -> default port 8883, false -> 1883
# AMPHIVE_BROKER_PORT=8883              # override if non-default
# Broker cert is signed by the AmpHive CA (self-signed) — point at ca.crt:
AMPHIVE_CA_FILE=../deploy/config/mqtt-certs/ca.crt
# Per-gateway broker credentials: USER must equal AMPHIVE_GATEWAY_ID (the
# broker ACL scopes each account to amphive/gateways/<user>/#). Created with
# deploy/scripts/add_gateway_user.ps1.
AMPHIVE_MQTT_USER=
AMPHIVE_MQTT_PASS=

# --- which ecosystems to run (comma-separated) ---
# kasa | shelly | sim
AMPHIVE_PROVIDERS=sim

# --- behavior ---
AMPHIVE_POLL_S=10                       # telemetry poll interval (SET_INTERVAL overrides)
AMPHIVE_STATE=amphive_agent_state.json  # plug_id map + session baselines (persisted)

# --- provider: kasa (Kasa/Tapo, local) ---
# Tapo/newer-Kasa need TP-Link account creds for the LOCAL KLAP handshake:
TPLINK_USER=
TPLINK_PASS=

# --- provider: shelly (Gen2+, local HTTP RPC) ---
AMPHIVE_SHELLY_HOSTS=                   # e.g. 192.168.1.50,192.168.1.51

# --- provider: sim (no hardware) ---
AMPHIVE_SIM_COUNT=2
