# Context Files (Local prototype references)
/chargehub_context/

# Environments
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# WireGuard tunnel config carries a private key — only the .example is tracked
deploy/config/amphive_tunnel.conf

# MQTT TLS private keys — NEVER commit. The public certs (ca.crt, server.crt)
# are tracked so the firmware build embeds the CA and mosquitto can mount the
# server cert; the CA + server keys stay local (+ on the VM). See
# deploy/config/mqtt-certs/README.md.
deploy/config/mqtt-certs/*.key
# Rotated-out cert material kept locally for reference — never commit.
deploy/config/mqtt-certs/retired-*/
*.key

# OTA firmware signing key (ECDSA, signed-app verification) — NEVER commit.
# Generate once (`espsecure.py generate_signing_key --version 1`) and BACK IT
# UP: devices with signed OTA enabled only accept images signed with this key;
# losing it means recovery-by-USB-reflash. See docs/FIRMWARE.md.
firmware/secure_boot_signing_key.pem

